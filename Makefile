# st - simple terminal
# See LICENSE file for copyright and license details.
.POSIX:

include config.mk

# Wayland protocol code generated by wayland-scanner
PROTODIR = protocols
PROTOS = xdg-shell \
         xdg-decoration-unstable-v1 \
         primary-selection-unstable-v1 \
         viewporter \
         fractional-scale-v1 \
         tablet-v2 \
         cursor-shape-v1 \
         xdg-system-bell-v1 \
         text-input-unstable-v3
PROTO_H = $(PROTODIR)/xdg-shell-client-protocol.h \
          $(PROTODIR)/xdg-decoration-unstable-v1-client-protocol.h \
          $(PROTODIR)/primary-selection-unstable-v1-client-protocol.h \
          $(PROTODIR)/viewporter-client-protocol.h \
          $(PROTODIR)/fractional-scale-v1-client-protocol.h \
          $(PROTODIR)/tablet-v2-client-protocol.h \
          $(PROTODIR)/cursor-shape-v1-client-protocol.h \
          $(PROTODIR)/xdg-system-bell-v1-client-protocol.h \
          $(PROTODIR)/text-input-unstable-v3-client-protocol.h
PROTO_C = $(PROTO_H:-client-protocol.h=-protocol.c)
PROTO_O = $(PROTO_C:.c=.o)

SRC = st.c wl.c $(LIGATURES_C) $(SIXEL_C)
OBJ = $(SRC:.c=.o)

all: st

config.h:
	cp config.def.h config.h

patches.h:
	cp patches.def.h patches.h

.c.o:
	$(CC) $(STCFLAGS) -I$(PROTODIR) -c -o $@ $<

# protocol generation
$(PROTODIR)/xdg-shell-client-protocol.h $(PROTODIR)/xdg-shell-protocol.c: $(PROTODIR)
	$(WAYLAND_SCANNER) client-header $(WAYLAND_PROTOCOLS)/stable/xdg-shell/xdg-shell.xml $(PROTODIR)/xdg-shell-client-protocol.h
	$(WAYLAND_SCANNER) private-code $(WAYLAND_PROTOCOLS)/stable/xdg-shell/xdg-shell.xml $(PROTODIR)/xdg-shell-protocol.c
$(PROTODIR)/xdg-decoration-unstable-v1-client-protocol.h $(PROTODIR)/xdg-decoration-unstable-v1-protocol.c: $(PROTODIR)
	$(WAYLAND_SCANNER) client-header $(WAYLAND_PROTOCOLS)/unstable/xdg-decoration/xdg-decoration-unstable-v1.xml $(PROTODIR)/xdg-decoration-unstable-v1-client-protocol.h
	$(WAYLAND_SCANNER) private-code $(WAYLAND_PROTOCOLS)/unstable/xdg-decoration/xdg-decoration-unstable-v1.xml $(PROTODIR)/xdg-decoration-unstable-v1-protocol.c
$(PROTODIR)/primary-selection-unstable-v1-client-protocol.h $(PROTODIR)/primary-selection-unstable-v1-protocol.c: $(PROTODIR)
	$(WAYLAND_SCANNER) client-header $(WAYLAND_PROTOCOLS)/unstable/primary-selection/primary-selection-unstable-v1.xml $(PROTODIR)/primary-selection-unstable-v1-client-protocol.h
	$(WAYLAND_SCANNER) private-code $(WAYLAND_PROTOCOLS)/unstable/primary-selection/primary-selection-unstable-v1.xml $(PROTODIR)/primary-selection-unstable-v1-protocol.c
$(PROTODIR)/viewporter-client-protocol.h $(PROTODIR)/viewporter-protocol.c: $(PROTODIR)
	$(WAYLAND_SCANNER) client-header $(WAYLAND_PROTOCOLS)/stable/viewporter/viewporter.xml $(PROTODIR)/viewporter-client-protocol.h
	$(WAYLAND_SCANNER) private-code $(WAYLAND_PROTOCOLS)/stable/viewporter/viewporter.xml $(PROTODIR)/viewporter-protocol.c
$(PROTODIR)/fractional-scale-v1-client-protocol.h $(PROTODIR)/fractional-scale-v1-protocol.c: $(PROTODIR)
	$(WAYLAND_SCANNER) client-header $(WAYLAND_PROTOCOLS)/staging/fractional-scale/fractional-scale-v1.xml $(PROTODIR)/fractional-scale-v1-client-protocol.h
	$(WAYLAND_SCANNER) private-code $(WAYLAND_PROTOCOLS)/staging/fractional-scale/fractional-scale-v1.xml $(PROTODIR)/fractional-scale-v1-protocol.c
$(PROTODIR)/tablet-v2-client-protocol.h $(PROTODIR)/tablet-v2-protocol.c: $(PROTODIR)
	$(WAYLAND_SCANNER) client-header $(WAYLAND_PROTOCOLS)/stable/tablet/tablet-v2.xml $(PROTODIR)/tablet-v2-client-protocol.h
	$(WAYLAND_SCANNER) private-code $(WAYLAND_PROTOCOLS)/stable/tablet/tablet-v2.xml $(PROTODIR)/tablet-v2-protocol.c
$(PROTODIR)/cursor-shape-v1-client-protocol.h $(PROTODIR)/cursor-shape-v1-protocol.c: $(PROTODIR)
	$(WAYLAND_SCANNER) client-header $(WAYLAND_PROTOCOLS)/staging/cursor-shape/cursor-shape-v1.xml $(PROTODIR)/cursor-shape-v1-client-protocol.h
	$(WAYLAND_SCANNER) private-code $(WAYLAND_PROTOCOLS)/staging/cursor-shape/cursor-shape-v1.xml $(PROTODIR)/cursor-shape-v1-protocol.c
$(PROTODIR)/xdg-system-bell-v1-client-protocol.h $(PROTODIR)/xdg-system-bell-v1-protocol.c: $(PROTODIR)
	$(WAYLAND_SCANNER) client-header $(WAYLAND_PROTOCOLS)/staging/xdg-system-bell/xdg-system-bell-v1.xml $(PROTODIR)/xdg-system-bell-v1-client-protocol.h
	$(WAYLAND_SCANNER) private-code $(WAYLAND_PROTOCOLS)/staging/xdg-system-bell/xdg-system-bell-v1.xml $(PROTODIR)/xdg-system-bell-v1-protocol.c

$(PROTODIR)/text-input-unstable-v3-client-protocol.h $(PROTODIR)/text-input-unstable-v3-protocol.c: $(PROTODIR)
	$(WAYLAND_SCANNER) client-header $(WAYLAND_PROTOCOLS)/unstable/text-input/text-input-unstable-v3.xml $(PROTODIR)/text-input-unstable-v3-client-protocol.h
	$(WAYLAND_SCANNER) private-code $(WAYLAND_PROTOCOLS)/unstable/text-input/text-input-unstable-v3.xml $(PROTODIR)/text-input-unstable-v3-protocol.c

$(PROTODIR):
	mkdir -p $(PROTODIR)

st.o: config.h st.h win.h
wl.o: arg.h config.h st.h win.h patch/font2.c patch/font2.h \
      patch/boxdraw.c patch/boxdraw.h patch/powerline.c patch/boxextra.c \
      patch/boxlines_extra.c patch/boxblocks_extra.c patch/boxcircles.c \
	patch/boxmosaics.c patch/boxbranch.c \
      $(LIGATURES_H) $(PROTO_H)
hb.o: st.h $(LIGATURES_H)
sixel.o: st.h win.h sixel.h

$(OBJ): config.h config.mk patches.h

st: $(OBJ) $(PROTO_O)
	$(CC) -o $@ $(OBJ) $(PROTO_O) $(STLDFLAGS)

clean:
	rm -f st $(OBJ) st-$(VERSION).tar.gz
	rm -rf $(PROTODIR)

dist: clean
	mkdir -p st-$(VERSION)
	cp -R FAQ LEGACY TODO LICENSE Makefile README config.mk\
		config.def.h st.info st.1 arg.h st.h win.h $(LIGATURES_H) $(SRC)\
		st-$(VERSION)
	tar -cf - st-$(VERSION) | gzip > st-$(VERSION).tar.gz
	rm -rf st-$(VERSION)

install: st
	mkdir -p $(DESTDIR)$(PREFIX)/bin
	cp -f st $(DESTDIR)$(PREFIX)/bin
	chmod 755 $(DESTDIR)$(PREFIX)/bin/st
	mkdir -p $(DESTDIR)$(MANPREFIX)/man1
	sed "s/VERSION/$(VERSION)/g" < st.1 > $(DESTDIR)$(MANPREFIX)/man1/st.1
	chmod 644 $(DESTDIR)$(MANPREFIX)/man1/st.1
	tic -sx st.info
	mkdir -p $(DESTDIR)$(PREFIX)/share/applications # desktop-entry patch
	test -f ${DESTDIR}${PREFIX}/share/applications/st.desktop || cp st.desktop $(DESTDIR)$(PREFIX)/share/applications # desktop-entry patch
	mkdir -p $(DESTDIR)$(ICONPREFIX)
	test -f $(DESTDIR)$(ICONPREFIX)/$(ICONNAME) || cp st.png $(DESTDIR)$(ICONPREFIX)/$(ICONNAME) # icon referenced by st.desktop
	@echo Please see the README file regarding the terminfo entry of st.

uninstall:
	rm -f $(DESTDIR)$(PREFIX)/bin/st
	rm -f $(DESTDIR)$(MANPREFIX)/man1/st.1
	rm -f $(DESTDIR)$(PREFIX)/share/applications/st.desktop # desktop-entry patch
	rm -f $(DESTDIR)$(ICONPREFIX)/$(ICONNAME)

.PHONY: all clean dist install uninstall
